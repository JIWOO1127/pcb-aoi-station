<Application x:Class="Inspection.Hmi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Inspection.Hmi.Converters">
    <Application.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush"/>
        <conv:DefectTypeToTextConverter x:Key="DefectToText"/>
        <conv:ClassNameConverter x:Key="ClassName"/>
        <conv:HoleListConverter x:Key="HoleList"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>

        <!--
          산업용 버튼 스타일.
          WPF 기본 비활성 템플릿은 커스텀 배경을 덮어써서 밝은 회색이 된다.
          "지금 누르면 안 되는 버튼"이 화면에서 가장 밝아지므로 직접 정의한다.
        -->
        <Style x:Key="HmiButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Back" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#5A5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 헤더가 흰 바탕이라 화면에서 두 번째로 밝아지는 문제를 막는다 -->
        <Style x:Key="HmiGridHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>
    </Application.Resources>
</Application>
