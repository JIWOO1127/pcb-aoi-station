<!--
  보드 미니어처 (v13).

  표시 문법: 불량 "유형"이 아니라 작업자가 할 "동작"으로 그린다. 색은 빨강 하나, 구분은 모양.
    Normal   연한 윤곽선 + 부품 ID (배치 참고용)
    Insert   꽂기    빨간 점선 빈 윤곽  — 여기가 비었다
    Replace  교체    빨간 실선 윤곽      — 이걸 바꿔라
    Remove   빼기    빨간 X             — 이걸 빼라
    Move     옮기기  빨간 점선(가야 할 자리) + 빨간 점(지금 덮인 홀)
  모든 불량에는 번호 배지를 붙이고, 오른쪽 카드도 같은 번호를 쓴다.

  v17: 부품을 네모 대신 실제 모양 아이콘으로 그린다 (이미지 파일 없이 도형으로).
    저항은 색띠까지 그려 330Ω(주황·주황·갈색)과 470Ω(노랑·보라·갈색)을 보드와 똑같이 구분한다.
    "다른 부품(330Ω → 470Ω)" 불량이 바로 이 색띠 차이이기 때문이다.
    꽂기·옮기기는 아이콘을 흐리게 그려 "여기에 이 모양을 꽂아라"를 보여준다.

  모양이 실제 검사 영역과 같은 비율(≈정사각형)이라, 나중에 배경을 정렬된 실제 사진으로
  바꿔도 같은 좌표로 그릴 수 있다.
-->
<UserControl x:Class="Inspection.Hmi.Controls.BoardMiniature"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Inspection.Hmi.ViewModels">

    <UserControl.Resources>
        <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.55" Duration="0:0:0.6"/>
        </Storyboard>

        <!-- 실선 윤곽: 정상(연하게) / 교체(빨강 두껍게) -->
        <Style x:Key="SolidOutline" TargetType="Rectangle">
            <!-- 정상 부품은 아이콘만으로 충분해서 윤곽선을 그리지 않는다 -->
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Replace}">
                    <Setter Property="Stroke" Value="#E53935"/>
                    <Setter Property="StrokeThickness" Value="3.5"/>
                    <Setter Property="Fill" Value="#33E53935"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource BlinkStoryboard}"/>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Remove}">
                    <Setter Property="Stroke" Value="#E53935"/>
                    <Setter Property="StrokeThickness" Value="3.5"/>
                </DataTrigger>
                <!-- 꽂기·옮기기는 점선 쪽이 그린다 -->
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Insert}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Move}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 점선 윤곽: 꽂기 / 옮기기(가야 할 자리) -->
        <Style x:Key="DashedOutline" TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Stroke" Value="#E53935"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeDashArray" Value="2 1.5"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
            <Setter Property="Fill" Value="#1FE53935"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Insert}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource BlinkStoryboard}"/>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Move}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 빼기: X -->
        <Style x:Key="CrossStyle" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Remove}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource BlinkStoryboard}"/>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 정상 부품 ID (불량이면 숨기고 동작 이름표를 대신 보인다) -->
        <Style x:Key="PartLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6355"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <!-- v17: 아이콘으로 대신한다 (부품 ID는 마우스를 올리면 툴팁으로) -->
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- 아이콘 층의 진하기: 정상은 또렷하게, 꽂기·옮기기는 "여기 들어갈 모양"이라 흐리게 -->
        <Style x:Key="IconLayer" TargetType="Viewbox">
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Insert}">
                    <Setter Property="Opacity" Value="0.35"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Move}">
                    <Setter Property="Opacity" Value="0.35"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Replace}">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Remove}">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 번호 배지 (불량일 때만) -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="-11,-11,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 동작 이름표 (불량일 때만, 윤곽 아래) -->
        <Style x:Key="VerbTagStyle" TargetType="Border">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <!-- 음수 좌우 여백: 폭이 1칸인 전선에서도 글자가 세로로 접히지 않게 자리를 넓혀 준다 -->
            <Setter Property="Margin" Value="-40,0,-40,-17"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Badge}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 부모 크기에 맞춰 키우고 줄인다 (v12까지는 DownOnly라 커지지 않았다) -->
    <Viewbox Stretch="Uniform">
        <Border Background="#EDE6D6" CornerRadius="6">
            <Grid Width="{Binding BoardWidth}" Height="{Binding BoardHeight}">

                <!-- 전원 레일 선 (실제 보드처럼 빨강·파랑). 방향 확인 보조 -->
                <Canvas IsHitTestVisible="False">
                    <!-- 실측 배치: 왼쪽은 빨강이 바깥, 오른쪽은 빨강이 안쪽 (열 0·1 = X 22·40, 열 12·13 = X 334·352) -->
                    <Line X1="8" Y1="4" X2="8" Y2="402" Stroke="#D9534F" StrokeThickness="1.5" Opacity="0.7"/>
                    <Line X1="55" Y1="4" X2="55" Y2="402" Stroke="#3F7FD9" StrokeThickness="1.5" Opacity="0.7"/>
                    <Line X1="319" Y1="4" X2="319" Y2="402" Stroke="#D9534F" StrokeThickness="1.5" Opacity="0.7"/>
                    <Line X1="367" Y1="4" X2="367" Y2="402" Stroke="#3F7FD9" StrokeThickness="1.5" Opacity="0.7"/>
                </Canvas>

                <!-- 배경 홀 격자 -->
                <ItemsControl ItemsSource="{Binding BoardCells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Size}" Height="{Binding Size}"
                                       Fill="#C4BAA6" RadiusX="1" RadiusY="1" ToolTip="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 부품 / 불량 표시 -->
                <ItemsControl ItemsSource="{Binding BoardParts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                            <Setter Property="Panel.ZIndex" Value="10"/>
                            <Style.Triggers>
                                <!-- 불량을 정상 위에 그린다 -->
                                <DataTrigger Binding="{Binding Badge}" Value="">
                                    <Setter Property="Panel.ZIndex" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}"
                                  Background="Transparent">
                                <!--
                                  부품 아이콘. 모두 가로 방향으로 그려 두고, 세로로 꽂힌 부품은 90도 돌린다.
                                  Viewbox가 부품이 차지한 홀 영역에 맞춰 크기를 조절한다.
                                -->
                                <Viewbox Style="{StaticResource IconLayer}" Margin="1">
                                    <Grid>
                                        <Grid.LayoutTransform>
                                            <RotateTransform Angle="{Binding IconAngle}"/>
                                        </Grid.LayoutTransform>

                                        <!-- 저항: 다리 + 몸통 + 색띠 3개 + 금색 띠 -->
                                        <Canvas Width="60" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=resistance330|resistance470}">
                                            <Line X1="0" Y1="8" X2="60" Y2="8" Stroke="#8A8A8A" StrokeThickness="1.6"/>
                                            <Rectangle Canvas.Left="12" Canvas.Top="2" Width="36" Height="12" RadiusX="5" RadiusY="5"
                                                       Fill="#E3C98F" Stroke="#B89A5E" StrokeThickness="0.6"/>
                                            <!-- 330Ω: 주황 주황 갈색 -->
                                            <Canvas Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=resistance330}">
                                                <Rectangle Canvas.Left="18" Canvas.Top="2" Width="3.5" Height="12" Fill="#F57C00"/>
                                                <Rectangle Canvas.Left="24" Canvas.Top="2" Width="3.5" Height="12" Fill="#F57C00"/>
                                                <Rectangle Canvas.Left="30" Canvas.Top="2" Width="3.5" Height="12" Fill="#6D3B1F"/>
                                            </Canvas>
                                            <!-- 470Ω: 노랑 보라 갈색 -->
                                            <Canvas Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=resistance470}">
                                                <Rectangle Canvas.Left="18" Canvas.Top="2" Width="3.5" Height="12" Fill="#F2C511"/>
                                                <Rectangle Canvas.Left="24" Canvas.Top="2" Width="3.5" Height="12" Fill="#7B3FA0"/>
                                                <Rectangle Canvas.Left="30" Canvas.Top="2" Width="3.5" Height="12" Fill="#6D3B1F"/>
                                            </Canvas>
                                            <Rectangle Canvas.Left="40" Canvas.Top="2" Width="3" Height="12" Fill="#C9A227"/>
                                        </Canvas>

                                        <!-- 전선: 색깔 굵은 선 (흰 선은 배경과 구분되게 회색 테두리) -->
                                        <Canvas Width="60" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=red_wire}">
                                            <Line X1="3" Y1="8" X2="57" Y2="8" Stroke="#D32F2F" StrokeThickness="6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                        <Canvas Width="60" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=black_wire}">
                                            <Line X1="3" Y1="8" X2="57" Y2="8" Stroke="#212121" StrokeThickness="6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                        <Canvas Width="60" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=white_wire}">
                                            <Line X1="3" Y1="8" X2="57" Y2="8" Stroke="#8A8A8A" StrokeThickness="7.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="3" Y1="8" X2="57" Y2="8" Stroke="#FAFAFA" StrokeThickness="5.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>

                                        <!-- LED: 빨간 원 + 반사광 -->
                                        <Canvas Width="30" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=led}">
                                            <Ellipse Canvas.Left="7.5" Canvas.Top="0.5" Width="15" Height="15"
                                                     Fill="#E53935" Stroke="#B71C1C" StrokeThickness="0.8"/>
                                            <Ellipse Canvas.Left="10.5" Canvas.Top="3" Width="4.5" Height="3.5" Fill="#FFCDD2"/>
                                        </Canvas>

                                        <!-- 캐패시터(전해): 어두운 원 + 극성 표시 띠 -->
                                        <Canvas Width="30" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=capacitor}">
                                            <Ellipse Canvas.Left="7.5" Canvas.Top="0.5" Width="15" Height="15"
                                                     Fill="#37474F" Stroke="#1C262B" StrokeThickness="0.8"/>
                                            <Rectangle Canvas.Left="9.5" Canvas.Top="4" Width="2.5" Height="8" Fill="#B0BEC5"/>
                                        </Canvas>

                                        <!-- IC: 검은 몸통 + 양쪽 핀 + 1번 핀 쪽 홈 -->
                                        <Canvas Width="70" Height="16"
                                                Visibility="{Binding Class, Converter={StaticResource ClassIs}, ConverterParameter=ic_chip}">
                                            <Rectangle Canvas.Left="3" Canvas.Top="0" Width="64" Height="2.5" Fill="#9E9E9E"/>
                                            <Rectangle Canvas.Left="3" Canvas.Top="13.5" Width="64" Height="2.5" Fill="#9E9E9E"/>
                                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="66" Height="12" RadiusX="1" RadiusY="1"
                                                       Fill="#212121"/>
                                            <Ellipse Canvas.Left="0" Canvas.Top="5" Width="6" Height="6" Fill="#616161"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>

                                <Rectangle Style="{StaticResource SolidOutline}"/>
                                <Rectangle Style="{StaticResource DashedOutline}"/>

                                <!-- 빼기: X -->
                                <Path Style="{StaticResource CrossStyle}" Stretch="Fill" Margin="3"
                                      Stroke="#E53935" StrokeThickness="3" Data="M0,0 L10,10 M10,0 L0,10"/>

                                <!-- 옮기기: 지금 덮인 홀 -->
                                <ItemsControl ItemsSource="{Binding Dots}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="#E53935"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 정상 부품 ID -->
                                <TextBlock Text="{Binding PartId}" Style="{StaticResource PartLabelStyle}"/>

                                <!-- 동작 이름표 -->
                                <Border Style="{StaticResource VerbTagStyle}">
                                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>

                                <!-- 번호 배지 -->
                                <Border Style="{StaticResource BadgeStyle}">
                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
