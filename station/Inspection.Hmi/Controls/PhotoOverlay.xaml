<!--
  실제 사진 위 불량 표시 (v18).

  추론 서비스가 준 "정렬된 사진"을 깔고, 구멍 좌표로 계산한 불량 표시를 그 위에 그린다.
  표시 문법은 보드 미니어처와 같다: 꽂기(점선) / 교체(실선) / 빼기(X) / 옮기기(점선 + 덮인 홀 점), 번호 배지.
  "모델이 본 것"을 켜면 YOLO 박스를 종류별 색으로 겹쳐 보여준다 (330Ω 주황, 470Ω 보라).

  좌표계: 사진 크기와 상관없이 가로 400으로 맞춘 좌표를 쓴다 (MainViewModel.PhotoViewWidth).
  그래야 사진이 크든 작든 선 두께와 글자 크기가 같아 보인다.
-->
<UserControl x:Class="Inspection.Hmi.Controls.PhotoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Inspection.Hmi.ViewModels">

    <UserControl.Resources>
        <Storyboard x:Key="Blink" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" Duration="0:0:0.6"/>
        </Storyboard>

        <!-- 실선: 교체 / 빼기 -->
        <Style x:Key="Solid" TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Stroke" Value="#FF1744"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
            <Setter Property="Fill" Value="#26FF1744"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Replace}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Blink}"/></DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Remove}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 점선: 꽂기 / 옮기기(가야 할 자리) -->
        <Style x:Key="Dashed" TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Stroke" Value="#FF1744"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeDashArray" Value="2 1.5"/>
            <Setter Property="RadiusX" Value="3"/>
            <Setter Property="RadiusY" Value="3"/>
            <Setter Property="Fill" Value="#33FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Insert}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Blink}"/></DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Move}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Cross" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PartShapeKind.Remove}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Blink}"/></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="400" Height="{Binding OverlayViewHeight}">
            <!-- 정렬된 실제 사진 -->
            <Image Source="{Binding OverlayImage}" Stretch="Fill"/>

            <!-- 모델이 본 것: YOLO 박스 -->
            <ItemsControl ItemsSource="{Binding ModelBoxes}" IsHitTestVisible="False"
                          Visibility="{Binding ShowModelBoxes, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                            <Rectangle Stroke="{Binding Color}" StrokeThickness="1.5"/>
                            <Border Background="#C0000000" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="0,-11,-60,0" Padding="2,0">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="7.5"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 불량 표시 -->
            <ItemsControl ItemsSource="{Binding OverlayParts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}"
                              Background="Transparent">
                            <Rectangle Style="{StaticResource Solid}"/>
                            <Rectangle Style="{StaticResource Dashed}"/>
                            <Path Style="{StaticResource Cross}" Stretch="Fill" Margin="3"
                                  Stroke="#FF1744" StrokeThickness="3" Data="M0,0 L10,10 M10,0 L0,10"/>

                            <!-- 옮기기: 지금 덮인 홀 -->
                            <ItemsControl ItemsSource="{Binding Dots}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="#FF1744"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 동작 이름표 -->
                            <Border Background="#FF1744" CornerRadius="3" Padding="4,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-40,0,-40,-17"
                                    IsHitTestVisible="False">
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>

                            <!-- 번호 배지 -->
                            <Border Background="#FF1744" BorderBrush="White" BorderThickness="1.5" CornerRadius="11"
                                    Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="-11,-11,0,0">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Viewbox>
</UserControl>
