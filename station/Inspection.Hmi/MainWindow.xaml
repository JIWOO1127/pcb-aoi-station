<Window x:Class="Inspection.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCB AOI 검사 스테이션" Width="1366" Height="800"
        Background="#1E1E1E" Foreground="White" FontSize="16">

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding InspectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenImageCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상태바 -->
            <RowDefinition Height="*"/>
            <!-- 본문 -->
            <RowDefinition Height="Auto"/>
            <!-- 조작바 -->
        </Grid.RowDefinitions>

        <!-- 상태바 -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedProduct, StringFormat=제품: {0}}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ImageDescription}"
                           Margin="24,0,0,0" Foreground="#9E9E9E"/>
                <TextBlock DockPanel.Dock="Right" Text="카메라 ● 추론 ● MES ● (연결 표시 예정)" Foreground="#9E9E9E"/>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- 본문 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Black" BorderBrush="#424242" BorderThickness="1" Margin="0,0,12,0">
                <TextBlock Text="카메라 영상 / 결과 이미지 영역" Foreground="#757575"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Height="140" CornerRadius="6"
                        Background="{Binding Verdict, Converter={StaticResource VerdictToBrush}}">
                    <TextBlock Text="{Binding Verdict, Converter={StaticResource VerdictToText}}"
                               FontSize="64" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="0,12" Orientation="Horizontal">
                    <TextBlock Text="{Binding DefectCount, StringFormat=불량 {0}건}" Foreground="#BDBDBD" Margin="0,0,24,0"/>
                    <TextBlock Text="{Binding LatencyMs, StringFormat=처리 {0} ms}" Foreground="#BDBDBD"/>
                </StackPanel>

                <ListView ItemsSource="{Binding Parts}" Background="#252526" Foreground="White" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Verdict}" Value="Fail">
                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="부품" Width="60" DisplayMemberBinding="{Binding PartId}"/>
                            <GridViewColumn Header="기대" Width="110" DisplayMemberBinding="{Binding ExpectedClass}"/>
                            <GridViewColumn Header="탐지" Width="110"
                                            DisplayMemberBinding="{Binding DetectedClass, TargetNullValue=-}"/>
                            <GridViewColumn Header="덮인 홀" Width="120"
                                            DisplayMemberBinding="{Binding CoveredHoles, Converter={StaticResource HoleList}}"/>
                            <GridViewColumn Header="결과" Width="70"
                                            DisplayMemberBinding="{Binding Defect, Converter={StaticResource DefectToText}}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- 조작바 -->
        <Border Grid.Row="2" Background="#2D2D2D" Padding="12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="검사 (Space)" Command="{Binding InspectCommand}"
                        Focusable="False" Width="200" Height="56" FontSize="20" FontWeight="Bold"/>
                <Button DockPanel.Dock="Left" Content="사진 열기 (Ctrl+O)" Command="{Binding OpenImageCommand}"
                        Focusable="False" Width="180" Height="56" FontSize="16" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Message}" Margin="20,0,0,0" FontSize="18"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
